rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for discovery)
      allow read: if isAuthenticated();

      // Users can only write their own profile
      allow write: if isOwner(userId);
    }

    // Swipes collection
    match /swipes/{swipeId} {
      // Users can create swipes where they are the swiper
      allow create: if isAuthenticated()
        && request.resource.data.swiperId == request.auth.uid;

      // Users can read swipes they created or are the target of
      allow read: if isAuthenticated()
        && (resource.data.swiperId == request.auth.uid
            || resource.data.targetId == request.auth.uid);

      // No updates or deletes allowed
      allow update, delete: if false;
    }

    // Blocks collection
    match /blocks/{blockId} {
      // Users can read blocks they created or are blocked by
      allow read: if isAuthenticated()
        && (resource.data.blockerId == request.auth.uid
            || resource.data.blockedId == request.auth.uid);

      // Users can create blocks where they are the blocker
      allow create: if isAuthenticated()
        && request.resource.data.blockerId == request.auth.uid;

      // Users can delete their own blocks (unblock)
      allow delete: if isAuthenticated()
        && resource.data.blockerId == request.auth.uid;

      allow update: if false;
    }

    // Reports collection
    match /reports/{reportId} {
      // Users can create reports where they are the reporter
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid;

      // No one can read, update, or delete reports (admin only)
      allow read, update, delete: if false;
    }

    // Moderation queue (admin only)
    match /moderation_queue/{userId} {
      allow read, write: if false; // Only Cloud Functions
    }

    // Rate limit logs (admin only)
    match /rate_limit_logs/{logId} {
      allow read: if false;
      allow create: if isAuthenticated();
    }

    // App config
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin only
    }

    // Matches collection
    match /matches/{matchId} {
      // Helper function to check if user is part of the match
      function isParticipant() {
        return request.auth.uid in resource.data.userIds;
      }

      function willBeParticipant() {
        return request.auth.uid in request.resource.data.userIds;
      }

      // Participants can read their matches
      allow read: if isAuthenticated() && isParticipant();

      // Only Cloud Functions can create matches (via admin SDK)
      // But allow participants to update (for unread status)
      allow create: if false; // Cloud Functions use admin SDK
      allow update: if isAuthenticated() && isParticipant();
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Participants can read messages
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds;

        // Participants can create messages
        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds
          && request.resource.data.senderId == request.auth.uid;

        // Messages can be updated for read status
        allow update: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds;

        allow delete: if false;
      }
    }
  }
}
